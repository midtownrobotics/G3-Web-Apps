[Unit]
Description=G3 Edge agent (usage collector and local API)
After=network-online.target nftables.service dnsmasq.service
Wants=network-online.target

[Service]
Type=simple
User=g3-edge
Group=g3-edge
# Root-only (mode 600); systemd reads it before dropping privileges.
EnvironmentFile=/etc/g3-edge/agent.env
ExecStart=/opt/g3-edge/current/g3-edge-agent
Restart=always
RestartSec=5

# nft needs CAP_NET_ADMIN; nothing else is granted.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes

# /var/lib/g3-edge, owned by g3-edge. Everything else is read-only.
StateDirectory=g3-edge
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
