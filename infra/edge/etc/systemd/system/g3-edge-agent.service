[Unit]
Description=G3 Edge agent (usage collector and local API)
After=network-online.target nftables.service dnsmasq.service g3-door-gpio.service
Wants=network-online.target
Requires=g3-door-gpio.service

[Service]
Type=simple
User=g3-edge
Group=g3-edge
# Root-only (mode 600); systemd reads it before dropping privileges.
EnvironmentFile=/etc/g3-edge/agent.env
ExecStart=/opt/g3-edge/current/g3-edge-agent
Restart=always
RestartSec=5

# nft needs CAP_NET_ADMIN; the shop drive's web page listens on port 80
# (CAP_NET_BIND_SERVICE). Nothing else is granted.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# /var/lib/g3-edge, owned by g3-edge, and the shop drive (setup-drive.sh; the
# "-" means it's fine if it doesn't exist yet). Everything else is read-only.
StateDirectory=g3-edge
StateDirectoryMode=0750
ReadWritePaths=-/srv/g3-drive -/srv/g3-sounds
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
