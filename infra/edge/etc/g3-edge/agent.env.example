# /etc/g3-edge/agent.env — root:root, mode 600. Never commit the real file.

# workers/edge base URL.
EDGE_WORKER_URL=https://api.edge.g3robotics.com

# Shared key; must match the worker's EDGE_AGENT_KEY secret.
# Generate with: openssl rand -hex 32
EDGE_AGENT_KEY=replace-me

# Optional overrides (defaults shown).
#EDGE_DB_PATH=/var/lib/g3-edge/agent.db
#EDGE_HTTP_PORT=8700
#EDGE_WAN_IF=wan0
#EDGE_LAN_IF=lan0
#EDGE_LAN_IP=192.168.50.1
#EDGE_LEASES_PATH=/var/lib/misc/dnsmasq.leases
#EDGE_DNS_LOG=/run/g3-edge-dns/queries.log
#EDGE_DNSMASQ_CONF=/var/lib/g3-edge/dnsmasq/g3-edge.conf
#EDGE_COLLECT_INTERVAL=300
