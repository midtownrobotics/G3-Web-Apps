{
  "name": "g3-web-apps",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/print-dev-ports.js",
    "dev:silent": "node scripts/run-enabled.js --parallel dev",
    "build": "node scripts/run-enabled.js build",
    "lint": "biome ci .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:migrate:local": "pnpm -r --if-present db:migrate:local",
    "db:migrate:remote": "pnpm -r --if-present db:migrate:remote"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
