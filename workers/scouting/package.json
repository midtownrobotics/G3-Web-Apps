{
  "name": "@g3/worker-scouting",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.toml --port 8792 --inspector-port 9234",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply SCOUTING_DB --config wrangler.local.toml --local",
    "db:migrate:prod": "wrangler d1 migrations apply SCOUTING_DB --env production --remote"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250516.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.14.0"
  }
}
